# Builds the official VirusTotal CLI (https://github.com/VirusTotal/vt-cli)
# Multi-stage: compile in Go → copy binary to minimal Alpine image
#
# Build:  docker build -t vt-cli:local -f Dockerfile.vt .
# Use:    docker run --rm -e VT_API_KEY=xxx vt-cli:local file <sha256>
#
# To update digests, run:
#   docker buildx imagetools inspect golang:1.22-alpine
#   docker buildx imagetools inspect alpine:3.20

FROM golang:1.22-alpine@sha256:1699c10032ca2582ec89a24a1312d986a3f094aed3d5c1147b19880afe40e052 AS builder
RUN apk add --no-cache git
RUN go install github.com/VirusTotal/vt-cli/vt@v1.0.1

FROM alpine:3.20@sha256:d9e853e87e55526f6b2917df91a2115c36dd7c696a35be12163d44e6e2a4b6bc
RUN apk add --no-cache ca-certificates
COPY --from=builder /go/bin/vt /usr/local/bin/vt
ENTRYPOINT ["vt"]
