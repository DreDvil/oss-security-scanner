# Builds the official VirusTotal CLI (https://github.com/VirusTotal/vt-cli)
# Multi-stage: compile in Go → copy binary to minimal Alpine image
#
# Build:  docker build -t vt-cli:local -f Dockerfile.vt .
# Use:    docker run --rm -e VT_API_KEY=xxx vt-cli:local file <sha256>

FROM golang:1.22-alpine AS builder
RUN apk add --no-cache git
RUN go install github.com/VirusTotal/vt-cli/vt@v1.0.1

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=builder /go/bin/vt /usr/local/bin/vt
ENTRYPOINT ["vt"]
